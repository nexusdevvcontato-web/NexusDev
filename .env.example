# Copy to a local environment file; never commit real secrets.
# Generate JWT_SECRET with: openssl rand -base64 48
# Replace the placeholder before starting the API.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/nexusdev
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=30d # Access-token lifetime; use a value from 1s to 365d
CORS_ORIGINS=http://localhost:5173

# Public key (PEM) used to verify RS256 completion proofs from the isolated code runner.
# Leave empty until the runner is deployed; lesson completion will fail closed.
LESSON_PROOF_PUBLIC_KEY=

# Optional until a sensitive-action flow is enabled; use a distinct random secret (>=32 chars).
REAUTH_TOKEN_SECRET=
