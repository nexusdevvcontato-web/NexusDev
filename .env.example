# Copy to a local environment file; never commit real secrets.
# The application must refuse to start if required values are missing.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/nexusdev
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m
CORS_ORIGINS=http://localhost:5173
